{
  "name": "intelligent-flow-canonical-demo",
  "private": true,
  "version": "5.0.0",
  "description": "Avenga Intelligent Flow \u2014 Canonical Pre-Sales Demo Console (PRD v5)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-runbook.mjs && vite",
    "demo": "node scripts/build-runbook.mjs && vite --open",
    "build": "node scripts/build-runbook.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "simulate": "node simulate-flow.js",
    "test:hash": "node src/lib/sha256.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:layout": "node scripts/layout-audit.mjs",
    "build:standalone": "node scripts/build-runbook.mjs && tsc --noEmit && vite build --config vite.standalone.config.ts",
    "test:standalone": "node scripts/verify-standalone.mjs",
    "test:download": "node scripts/verify-download.mjs",
    "test:runbook": "node scripts/verify-runbook.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.1.0"
  }
}
